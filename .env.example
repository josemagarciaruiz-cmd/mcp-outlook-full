# ─────────────────────────────────────────────────────────────────────────
# MCP Outlook (conector completo + agente) — configuración
# Copia este fichero a  .env  y rellena tus valores.
#
# CLIENT_ID y TENANT_ID salen de registrar una app en Azure (Entra ID).
# Cómo obtenerlos, paso a paso, en la GUÍA DETALLADA (carpeta de Drive) o el README.
# ─────────────────────────────────────────────────────────────────────────

# App de Azure (Entra ID) — obligatorios
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT_ID=

# Zona horaria por defecto para fechas
OUTLOOK_TIMEZONE=Europe/Madrid

# Carpetas del disco que el AGENTE tiene permitido tocar (adjuntar, guardar
# adjuntos, export .eml, subir/bajar OneDrive). Separadas por ":" (o ";").
# El agente se niega a salir de aquí. (El conector completo no usa esta variable.)
OUTLOOK_ALLOWED_DIRS=~/Downloads:~/Documents:~/Desktop

# (Opcional) Dónde guardar el token de sesión. Por defecto ~/.outlook-mcp/token_cache.bin
# OUTLOOK_TOKEN_CACHE=~/.outlook-mcp/token_cache.bin
